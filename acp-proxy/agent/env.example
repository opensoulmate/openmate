# OpenMate内置Agent LLM配置
# 复制此文件为 .env 并填入实际值

# LLM API配置（OpenAI兼容接口）
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b

# 模型降级有序链（CowAgent chat_fallback，utils/model_fallback.py）——opt-in
# 主模型失败（重试耗尽/不可重试/429限流）时按序切换备胎模型；429有备胎立即切换不干等；
# 每备胎只给1发；走完环绕第二遍；链耗尽报错列出所有试过的模型；空/不配置=行为不变。
# 格式（二选一）：
#   紧凑: LLM_FALLBACK_CHAIN=provider:model,provider:model
#   JSON: LLM_FALLBACK_CHAIN=[{"provider": "qwen", "model": "qwen-turbo"}]
# provider取值见 model_router.PROVIDER_ENV（mimo/openai/claude/deepseek/qwen/ollama），
# 凭据/端点按各provider的环境别名解析（.env文件优先）
# LLM_FALLBACK_CHAIN=ollama:qwen3:8b

# ACP Agent Server配置
ACP_AGENT_HOST=0.0.0.0
ACP_AGENT_PORT=8787
