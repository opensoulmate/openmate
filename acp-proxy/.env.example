# 国内网关（钉钉/飞书）接入配置模板
# 复制为 .env 并填入实际值；.env 已被 .gitignore 忽略，真实凭据不进 git。
# 用法说明见 docs/gateway-domestic-feishu-dingtalk.md

# ── Level 1 · webhook 机器人快路（只需填 webhook 地址即可收 agent 消息推送） ──
# 钉钉群自定义机器人 webhook 地址
DINGTALK_WEBHOOK_URL=
# 飞书群自定义机器人 webhook 地址
FEISHU_WEBHOOK_URL=
# 钉钉机器人「加签」安全设置开启时才填（SEC 开头）
DINGTALK_WEBHOOK_SECRET=
# 飞书机器人「签名校验」开启时才填
FEISHU_WEBHOOK_SECRET=

# ── Level 2 · 自建应用全双工（收消息 → SoulMate 处理 → 回消息） ──
# 钉钉企业内部应用 Client ID / Client Secret
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# 飞书企业自建应用 App ID / App Secret
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ── 运行时（可选，有默认值） ──
# 去重/会话映射库路径
# SOULMATE_DOMESTIC_DB_PATH=~/.hermes/soulmate/memory/domestic_bridge.db
# 入站轮询间隔秒
# SOULMATE_DOMESTIC_POLL_S=5
# 回复单块最大字符
# SOULMATE_DOMESTIC_MAX_BLOCK=2000
