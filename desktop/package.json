{
  "name": "openmate-desktop",
  "productName": "OpenMate",
  "version": "1.1.2",
  "description": "OpenMate Desktop — Electron 薄壳，加载 OpenMate Web（:3000），网页版/桌面版同源，支持在线更新",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis dir"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "top.climbing.openmate",
    "productName": "OpenMate",
    "publish": [
      {
        "provider": "generic",
        "url": "https://climbing.top/openmate-releases/"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "OpenMate",
      "artifactName": "OpenMate-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Network"
    }
  }
}
