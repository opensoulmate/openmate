{
  "name": "openmate-desktop",
  "productName": "OpenMate",
  "version": "1.3.11",
  "description": "OpenMate Desktop — Electron 薄壳，加载 OpenMate Web（:3000），网页版/桌面版同源，支持在线更新",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis dir"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "top.climbing.openmate",
    "productName": "OpenMate",
    "publish": [
      {
        "provider": "generic",
        "url": "https://climbing.top/openmate-releases/"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "extraResources": [
        {
          "from": "../core/dist",
          "to": ".",
          "filter": [
            "download-engine.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "shortcutName": "OpenMate",
      "artifactName": "OpenMate-Setup-${version}.${ext}",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Network",
      "extraResources": [
        {
          "from": "../core/dist",
          "to": ".",
          "filter": [
            "download-engine"
          ]
        }
      ]
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}