{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/refs/heads/v2/crates/tauri-cli/config.schema.json",
  "productName": "OpenMate",
  "version": "0.1.0",
  "identifier": "com.openmate.app",
  "build": {
    "frontendDist": "http://100.76.2.155:3000",
    "devUrl": "http://100.76.2.155:3000",
    "beforeDevCommand": "npm run dev -- --port 3002",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "OpenMate｜开放协同的AI智能伙伴",
        "decorations": false,
        "width": 1200,
        "height": 800,
        "minWidth": 375,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/open-soulmate/openmate/main/updater.json"
      ],
      "pubkey": ""
    }
  }
}